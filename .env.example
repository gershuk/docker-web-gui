# Credentials for the built-in admin account (there is no registration).
# Used to seed the account on the FIRST start of the service.
# Copy this file to .env and set your own values before the first start.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me

# Sliding session lifetime in days (default: 180 = 6 months).
# SESSION_TTL_DAYS=180

# bcrypt cost factor (default: 10).
# AUTH_BCRYPT_ROUNDS=10
