# Credentials for the built-in admin account (there is no registration).
# Used to seed the account on the FIRST start of the service.
# Copy this file to .env and set your own values before the first start.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me

# Sliding session lifetime in days (default: 180 = 6 months).
# SESSION_TTL_DAYS=180

# bcrypt cost factor (default: 10).
# AUTH_BCRYPT_ROUNDS=10

# Behind a reverse proxy (nginx): number of trusted proxy hops (usually 1).
# Makes the login rate-limit use the real client IP and the session cookie
# get the Secure flag (requires nginx to send X-Forwarded-For / X-Forwarded-Proto).
# TRUST_PROXY=1

# Session cookie Secure attribute: true / false / auto (default).
# auto = set when the request arrives over HTTPS.
# COOKIE_SECURE=auto

# Extra cross-origin hosts allowed to call the API (comma separated).
# Same-origin requests are always allowed. Only needed for local development,
# e.g. the Create React App dev server on :3000.
# CORS_ORIGIN=http://localhost:3000
